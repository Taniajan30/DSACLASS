class Solution {
    public int totalNQueens(int n) {
        char[][] grid = new char[n][n];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                grid[i][j] = '.';
            }
        }
        return count(grid, 0, n);
    }

    public int count(char[][] grid, int row, int n) {
        if (row == n) {
            return 1;
        }

        int cnt = 0;

        for (int col = 0; col < n; col++) {
            if (isSafe(grid, row, col, n)) {
                grid[row][col] = 'Q';

                cnt += count(grid, row + 1, n);

                grid[row][col] = '.';
            }
        }

        return cnt;
    }

    public boolean isSafe(char[][] grid, int row, int col, int n) {
        for (int i = 0; i < row; i++) {
            if (grid[i][col] == 'Q') {
                return false;
            }
        }
        int i = row - 1;
        int j = col - 1;

        while (i >= 0 && j >= 0) {
            if (grid[i][j] == 'Q') {
                return false;
            }
            i--;
            j--;
        }
        i = row - 1;
        j = col + 1;

        while (i >= 0 && j < n) {
            if (grid[i][j] == 'Q') {
                return false;
            }
            i--;
            j++;
        }

        return true;
    }
}
